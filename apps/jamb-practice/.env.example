# Copy to .env.local for development. Never commit real values.
# Generate secrets with: npm run make:secret / make:vapid / make:admin-hash

# Public origin; absolute URLs are built from this, never from request headers.
APP_BASE_URL=http://localhost:3000
BASE_PATH=/jamb-practice

# In production: the postgres:// connection string from your database provider. pglite:<folder> runs a local
# Postgres in WASM for development (pglite:memory for throwaway).
DATABASE_URL=pglite:.data/dev

SESSION_SECRET=
IP_HASH_SALT=

# paystack in preview and production; fake (a test checkout page) for local development
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# If set, students without an email pay with student-<id>@<this domain>.
# Leave empty to ask for an email at checkout. Confirm with Paystack first.
PAYMENT_PLACEHOLDER_EMAIL_DOMAIN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

CRON_SECRET=
# bcrypt hash: npm run make:admin-hash -- "a long password"
# The script prints it base64url-encoded, so it contains no $ for .env loaders to expand.
ADMIN_PASSWORD_HASH=

SUPPORT_WHATSAPP_E164=2348000000000
SUPPORT_EMAIL=support@example.com
PRODUCT_NAME=UTME English Booster
# Legal pages. Leave empty until confirmed by the owner.
LEGAL_BUSINESS_NAME=
PRIVACY_CONTACT_EMAIL=

# true only in local and preview. Must be false in production.
ALLOW_UNREVIEWED_CONTENT=true
# content/jamb-english in production; the fixtures folder in development.
CONTENT_DIR=content/jamb-english/_fixtures

NODE_ENV=development
